
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily News - News & Magazine</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header -->
    <header class="header">
        <div class="logo">DAILY<span>NEWS</span></div>
        <p>Your Trusted Source for Latest News</p>
    </header>

    <!-- Navigation -->
    <nav class="navbar">
        <a href="#">Home</a>
        <a href="#world">World</a>
        <a href="#politics">Politics</a>
        <a href="#technology">Technology</a>
        <a href="#sports">Sports</a>
        <a href="#entertainment">Entertainment</a>
        <a href="#business">Business</a>
    </nav>

    <!-- Breaking News -->
    <div class="breaking">
        <strong>BREAKING NEWS</strong>
        <marquee>
            Latest updates from around the world |
            Technology is changing the future |
            Stay updated with Daily News
        </marquee>
    </div>

    <!-- Main Container -->
    <div class="container">

        <main class="content">

            <!-- Headline Section -->
            <section class="headline">
                <img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1000"
                     alt="Newspaper and news">

                <div class="headline-text">
                    <span class="category">TOP STORY</span>
                    <h1>Latest Headlines and Important News From Around the World</h1>
                    <p>
                        Get the latest updates, breaking news and important
                        stories happening around the world.
                    </p>
                    <p class="author">By Admin | November 24, 2026</p>
                    <a href="#" class="read-btn">Read More</a>
                </div>
            </section>

            <!-- News Categories -->
            <section class="news-section">
                <h2>Top News Categories</h2>

                <div class="categories">
                    <div class="category-card" id="world">
                        <img src="https://images.unsplash.com/photo-1521295121783-8a321d551ad2?w=400"
                             alt="World news">
                        <h3>World News</h3>
                    </div>

                    <div class="category-card" id="politics">
                        <img src="https://images.unsplash.com/photo-1529107386315-e1a2ed48a620?w=400"
                             alt="Politics">
                        <h3>Politics</h3>
                    </div>

                    <div class="category-card" id="technology">
                        <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=400"
                             alt="Technology">
                        <h3>Technology</h3>
                    </div>

                    <div class="category-card" id="sports">
                        <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=400"
                             alt="Sports">
                        <h3>Sports</h3>
                    </div>
                </div>
            </section>

            <!-- Featured Articles -->
            <section class="news-section">
                <h2>Featured Articles</h2>

                <div class="articles">

                    <article class="article-card">
                        <img src="https://images.unsplash.com/photo-1485827404703-89b55fcc595e?w=500"
                             alt="Technology">
                        <div class="article-info">
                            <span>Technology</span>
                            <h3>Artificial Intelligence is Transforming the World</h3>
                            <p>Discover how modern technology is changing our daily lives.</p>
                            <small>By John Smith | 5 min read</small>
                        </div>
                    </article>

                    <article class="article-card">
                        <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=500"
                             alt="Business">
                        <div class="article-info">
                            <span>Business</span>
                            <h3>New Business Trends in the Modern World</h3>
                            <p>Explore the latest developments in the business industry.</p>
                            <small>By Sarah Johnson | 4 min read</small>
                        </div>
                    </article>

                    <article class="article-card">
                        <img src="https://images.unsplash.com/photo-1517649763962-0c623066013b?w=500"
                             alt="Sports">
                        <div class="article-info">
                            <span>Sports</span>
                            <h3>Sports Events That Everyone is Talking About</h3>
                            <p>Read about exciting moments and sports highlights.</p>
                            <small>By David Wilson | 3 min read</small>
                        </div>
                    </article>

                </div>
            </section>

            <!-- Latest News -->
            <section class="news-section">
                <h2>Latest News</h2>

                <div class="latest-news">

                    <div class="latest-card">
                        <img src="https://images.unsplash.com/photo-1495020689067-958852a7765e?w=300"
                             alt="Newspaper">
                        <div>
                            <h3>Today's Major News Headlines</h3>
                            <p>Stay informed about the latest happenings.</p>
                            <small>By Admin | Today</small>
                        </div>
                    </div>

                    <div class="latest-card">
                        <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=300"
                             alt="Digital technology">
                        <div>
                            <h3>Digital Technology and Innovation</h3>
                            <p>New innovations are shaping our future.</p>
                            <small>By Michael | Today</small>
                        </div>
                    </div>

                    <div class="latest-card">
                        <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=300"
                             alt="Business meeting">
                        <div>
                            <h3>Global Business Updates</h3>
                            <p>Important updates from the business world.</p>
                            <small>By Sarah | Today</small>
                        </div>
                    </div>

                </div>
            </section>

        </main>

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="sidebar-box">
                <h2>About Us</h2>
                <p>
                    Daily News brings you the latest updates, trending
                    stories and important information from around the world.
                </p>
            </div>

            <div class="sidebar-box">
                <h2>Popular News</h2>
                <ul>
                    <li>Latest Technology Updates</li>
                    <li>World News Headlines</li>
                    <li>Sports Highlights</li>
                    <li>Business News</li>
                    <li>Entertainment Updates</li>
                </ul>
            </div>

            <div class="sidebar-box">
                <h2>Categories</h2>
                <ul>
                    <li>World</li>
                    <li>Politics</li>
                    <li>Technology</li>
                    <li>Sports</li>
                    <li>Business</li>
                    <li>Entertainment</li>
                </ul>
            </div>

            <div class="sidebar-box author-box">
                <h2>Our Editor</h2>
                <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300"
                     alt="Editor">
                <h3>John Smith</h3>
                <p>Chief Editor of Daily News</p>
            </div>

        </aside>

    </div>

    <!-- Footer -->
    <footer>
        <h2>DAILY NEWS</h2>
        <p>Your Trusted Source for Latest News</p>
        <p>© 2026 Daily News. All Rights Reserved.</p>

        <div class="footer-links">
            <a href="#">About</a>
            <a href="#">Contact</a>
            <a href="#">Privacy Policy</a>
        </div>
    </footer>

</body>
</html>
