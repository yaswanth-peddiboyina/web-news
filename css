
/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f4f4;
    color: #222;
    line-height: 1.6;
}

/* Header */
.header {
    background: white;
    text-align: center;
    padding: 25px;
}

.logo {
    font-size: 38px;
    font-weight: bold;
    color: #222;
}

.logo span {
    color: #e63946;
}

.header p {
    color: #777;
    margin-top: 5px;
}

/* Navigation Bar */
.navbar {
    background: #222;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
}

.navbar a {
    color: white;
    text-decoration: none;
    padding: 15px 22px;
    transition: 0.3s;
}

.navbar a:hover {
    background: #e63946;
}

/* Breaking News */
.breaking {
    display: flex;
    align-items: center;
    background: #e63946;
    color: white;
    padding: 12px;
    gap: 15px;
}

.breaking strong {
    white-space: nowrap;
}

.breaking marquee {
    font-size: 14px;
}

/* Main Layout */
.container {
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 2.5fr 1fr;
    gap: 25px;
}

.content {
    min-width: 0;
}

/* Headline */
.headline {
    background: white;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(0,0,0,0.08);
}

.headline img {
    width: 100%;
    height: 320px;
    object-fit: cover;
}

.headline-text {
    padding: 25px;
}

.category {
    display: inline-block;
    background: #e63946;
    color: white;
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
}

.headline h1 {
    font-size: 27px;
    margin: 12px 0;
}

.headline p {
    color: #666;
    margin-bottom: 10px;
}

.author {
    font-size: 13px;
}

.read-btn {
    display: inline-block;
    background: #e63946;
    color: white;
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 5px;
    margin-top: 10px;
}

.read-btn:hover {
    background: #b51f2b;
}

/* Section Titles */
.news-section {
    margin-top: 35px;
}

.news-section h2 {
    border-left: 5px solid #e63946;
    padding-left: 12px;
    margin-bottom: 20px;
    font-size: 23px;
}

/* Categories */
.categories {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.category-card {
    background: white;
    text-align: center;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: 0.3s;
}

.category-card:hover {
    transform: translateY(-5px);
}

.category-card img {
    width: 100%;
    height: 110px;
    object-fit: cover;
}

.category-card h3 {
    padding: 12px 5px;
    font-size: 15px;
}

/* Featured Articles */
.articles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.article-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: 0.3s;
}

.article-card:hover {
    transform: translateY(-5px);
}

.article-card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
}

.article-info {
    padding: 15px;
}

.article-info span {
    color: #e63946;
    font-size: 13px;
    font-weight: bold;
}

.article-info h3 {
    margin: 8px 0;
    font-size: 18px;
}

.article-info p {
    color: #666;
    font-size: 14px;
}

.article-info small {
    display: block;
    color: #999;
    margin-top: 12px;
}

/* Latest News */
.latest-news {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.latest-card {
    display: flex;
    align-items: center;
    gap: 15px;
    background: white;
    padding: 12px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.latest-card img {
    width: 120px;
    height: 90px;
    object-fit: cover;
    border-radius: 5px;
}

.latest-card h3 {
    font-size: 16px;
}

.latest-card p {
    color: #666;
    font-size: 13px;
}

.latest-card small {
    color: #999;
}

/* Sidebar */
.sidebar-box {
    background: white;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.sidebar-box h2 {
    font-size: 19px;
    border-bottom: 2px solid #e63946;
    padding-bottom: 10px;
    margin-bottom: 15px;
}

.sidebar-box p {
    color: #666;
    font-size: 14px;
}

.sidebar-box ul {
    list-style: none;
}

.sidebar-box li {
    padding: 9px 0;
    border-bottom: 1px solid #eee;
    font-size: 14px;
}

.sidebar-box li:last-child {
    border-bottom: none;
}

.author-box {
    text-align: center;
}

.author-box img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 10px;
}

.author-box h3 {
    margin-bottom: 5px;
}

/* Footer */
footer {
    background: #222;
    color: white;
    text-align: center;
    padding: 30px 15px;
    margin-top: 40px;
}

footer h2 {
    color: #e63946;
    font-size: 28px;
}

footer p {
    color: #ccc;
    margin: 8px 0;
}

.footer-links {
    margin-top: 15px;
}

.footer-links a {
    color: white;
    text-decoration: none;
    margin: 0 12px;
}

.footer-links a:hover {
    color: #e63946;
}

/* Responsive Design */
@media (max-width: 900px) {
    .container {
        grid-template-columns: 1fr;
    }

    .categories {
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }
}

@media (max-width: 600px) {
    .logo {
        font-size: 28px;
    }

    .navbar a {
        padding: 10px;
        font-size: 13px;
    }

    .container {
        padding: 0 12px;
    }

    .headline img {
        height: 200px;
    }

    .headline h1 {
        font-size: 21px;
    }

    .articles {
        grid-template-columns: 1fr;
    }

    .categories {
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar {
        display: block;
    }

    .latest-card img {
        width: 90px;
        height: 80px;
    }

    .latest-card h3 {
        font-size: 14px;
    }

    .breaking {
        font-size: 12px;
    }
}
